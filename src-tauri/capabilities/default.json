{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-rename",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ],
      "deny": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "$RESOURCE/**"
        },
        {
          "path": "C:\\Windows/**"
        },
        {
          "path": "C:\\Program Files/**"
        },
        {
          "path": "C:\\Program Files (x86)/**"
        }
      ]
    }
  ]
}